# Copy this file to .env and fill in your Foundry settings.
# .env is gitignored and will never be committed.
# Authentication uses DefaultAzureCredential, not an API key.
# Use the full OpenAI v1 endpoint from your Foundry deployment's code sample.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT-NAME

# Original OpenAI/Kimi backends remain available.
# Remove BOTH Azure settings above to use these instead.
OPENAI_API_KEY=sk-your-key-goes-here

# Kimi (Moonshot) configuration — optional side-lesson alternative  
# Leave KIMI_API_KEY empty to stay on OpenAI.
# Set both to switch the agent to Kimi K2.6.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1